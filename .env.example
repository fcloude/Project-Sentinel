# Copy to .env and fill in. NEVER commit .env.
# Generate SECRET_KEY and SENTINEL_ENCRYPTION_KEYS with:  python tools/gen_secrets.py
# The app refuses to start while either value is empty or a placeholder.
SECRET_KEY=
SENTINEL_ENCRYPTION_KEYS=

# Network: loopback by default. Changing HOST requires SENTINEL_ALLOW_LAN=true (and HTTPS via a reverse proxy).
HOST=127.0.0.1
PORT=5000
SENTINEL_ALLOW_LAN=false
SENTINEL_HTTPS=false
# Number of reverse proxies in front (0 = none). Only set if you really run one; otherwise client IPs can be spoofed.
SENTINEL_TRUSTED_PROXIES=0
# Comma-separated extra origins allowed to submit forms (e.g. https://sentinel.example.com).
SENTINEL_TRUSTED_ORIGINS=
# Needed only if you allow LAN access BEFORE the first admin exists.
SENTINEL_SETUP_TOKEN=

DATABASE_PATH=data/database/sentinel.db
SNAPSHOT_DIR=snapshots
# Face models (YuNet + SFace). Defaults to ./models next to run.py.
MODELS_DIR=models
# Video-file cameras are a demo/testing feature; leave off for real installs.
ALLOW_FILE_SOURCES=false
LOG_LEVEL=INFO
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
MAX_UPLOAD_MB=5

# Optional bring-your-own Telegram bot (create a NEW token with @BotFather and never commit it).
# Imported once into an encrypted alert channel when the Alerts page is first opened.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
