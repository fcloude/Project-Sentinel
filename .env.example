# Copy to .env and edit. NEVER commit .env.

APP_NAME=Project Sentinel
DEBUG=False
LOG_LEVEL=INFO

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Database (SQLite). The folder is created automatically.
DATABASE_PATH=data/sentinel.db

# Dashboard bind address. Keep 127.0.0.1 unless you understand the risks.
HOST=127.0.0.1
PORT=5000

# Camera: USB index (0) or a URL / file path. Examples:
#   CAMERA_INDEX=0
#   CAMERA_SOURCE=file:tests/data/sample.mp4
CAMERA_INDEX=0

# Data retention (days)
RETENTION_DAYS=30

# Optional bring-your-own Telegram channel (create a bot with @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Set True only when serving the dashboard over HTTPS
COOKIE_SECURE=False

# Allow "video file" cameras (demos/testing). Leave False in production.
ALLOW_FILE_SOURCES=False

# Folder holding the face models (default: the "models" folder in the project)
# MODELS_DIR=models
